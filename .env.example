# ── GPU settings ─────────────────────────────────────────────────────────────
# Overrides cuda_devices in your YAML config.
CUDA_VISIBLE_DEVICES=0,1

# Directory where HuggingFace downloads and caches models.
# Leave blank to use the default (~/.cache/huggingface).
HF_HOME=

# Token for gated models (e.g. JINA v3).  Get it from huggingface.co/settings/tokens.
HF_TOKEN=

# ── Stage 3: OpenAI (NQ-Tables) ──────────────────────────────────────────────
# Required when stage3.provider = openai.
OPENAI_API_KEY=

# ── Stage 3: Gemini (OTT-QA) ─────────────────────────────────────────────────
# Required when stage3.provider = gemini.
GEMINI_API_KEY=

# ── Stage 2: JINA Embeddings v3 REST API (alternative to HuggingFace) ────────
JINA_API_KEY=

# ── Optional: NQ-Tables descriptions path ────────────────────────────────────
# Path to the LLM-generated table descriptions file.
# If set, the NQ loader will include them in the corpus text.
NQ_DESC_PATH=datasets/nq_table_summary_table_description.jsonl
