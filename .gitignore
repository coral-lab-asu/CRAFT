# ── Secrets ──────────────────────────────────────────────────────────────────
.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# All notebooks are ignored by default — only the three user-facing stage notebooks
# (scripts/stage1.ipynb, stage2.ipynb, stage3.ipynb) are explicitly un-ignored below.
utils/*.ipynb
scripts/*.ipynb

!scripts/stage1.ipynb
!scripts/stage2.ipynb
!scripts/stage3.ipynb

# ── Pipeline outputs (re-generated by preprocess.py + retrieve.py) ────────────
results/
*.log
*.npy

# ── Raw datasets — too large for git, download from original sources ──────────
# NQ-Tables: https://github.com/google-research/tapas (NQ-Tables split)
datasets/NQ_Tables/
# OTT-QA: https://github.com/wenhuchen/OTT-QA
datasets/OTT-QA/

# ── Large precomputed / intermediate files ────────────────────────────────────
# All pickle files in datasets/ (SPLADE index, row embeddings, rankings — multi-GB)
datasets/*.pkl
# Backup files
datasets/*.bak
datasets/*.bak_*
datasets/*.jsonl.bak
# Large intermediate JSONL results (322 MB–1.3 GB each)
datasets/nq_stage1.jsonl
datasets/nq_stage2.jsonl
datasets/ottqa_stage2_results.jsonl
# LLM-generated table descriptions for NQ (180 MB) — download from Drive
datasets/nq_table_summary_table_description.jsonl
# Old-format row/table files from pre-pipeline scripts (superseded)
datasets/nq_row_tables_INDIV_Table.json
datasets/ottqa_row_tables.pkl
datasets/ottqa_top_rows.pkl
# Old experiment / log files
datasets/CRAFT_NQ_Final_Splade_ST_OpenAI_LARGE_ranks_966_100_actual_rerank_corpus.txt
datasets/LARGE_corpus_4th_stage_*.pkl
datasets/corpus_2nd_stage_row_rerank_with_ST_original_q.pkl
datasets/corpus_top5000_reranked_with_SentTrasf_title_head_desc.pkl

# ── Small precomputed NQ Stage 3 results — TRACKED for reproducibility ────────
# nq_stage3_small.jsonl (~8 MB) and nq_stage3_large.jsonl (~3 MB) let users
# reproduce NQ-Tables Stage 3 results without calling the OpenAI API.
!datasets/nq_stage3_small.jsonl
!datasets/nq_stage3_large.jsonl

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
